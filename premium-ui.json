{
  "profile": "product-admin",
  "sourceRoots": [
    "web/src"
  ],
  "locale": "zh-Hant",
  "canonicalMap": "UX-CONTRACT.md",
  "requiredCapabilities": [
    "Select/Listbox",
    "Scrollbar",
    "Toast"
  ],
  "ownership": {
    "Select/Listbox": "native"
  },
  "requiredCommands": [
    "build",
    "regressions",
    "deployment",
    "data",
    "audio",
    "extraAudio",
    "select"
  ],
  "commands": {
    "build": "python3 web/scripts/build.py --check",
    "regressions": "node web/tests/run.cjs",
    "deployment": "python3 tests/deploy_test.py",
    "data": "node --check web/dist/data.js",
    "audio": "node --check web/dist/audio-manifest.js",
    "extraAudio": "node --check web/dist/extra-audio.js",
    "select": "node --check web/dist/select.js"
  }
}
