{
  "profile": "product-admin",
  "sourceRoots": [
    "dist"
  ],
  "locale": "zh-Hant",
  "canonicalMap": "UX-CONTRACT.md",
  "requiredCapabilities": [
    "Select/Listbox",
    "Scrollbar",
    "Toast"
  ],
  "ownership": {
    "Select/Listbox": "authored"
  },
  "requiredCommands": [
    "javascript",
    "data",
    "languages",
    "audio",
    "extraAudio",
    "select",
    "dictionaries",
    "workspace"
  ],
  "commands": {
    "javascript": "node --check dist/app.js",
    "data": "node --check dist/data.js",
    "languages": "node --check dist/languages.js",
    "audio": "node --check dist/audio-manifest.js",
    "extraAudio": "node --check dist/extra-audio.js",
    "select": "node --check dist/select.js",
    "dictionaries": "node --check dist/dictionaries.js",
    "workspace": "node --check dist/workspace.js"
  }
}
